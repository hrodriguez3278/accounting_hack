# ─────────────────────────────────────────────────────────────────────────────
# NEXORA AI — variables de entorno
# Copiar a .env (nunca se versiona). Para Supabase local: `npx supabase status -o env`.
# Un Supabase hospedado debe ser provisionado por el equipo de Transformación Digital;
# no usar cuentas personales.
# ─────────────────────────────────────────────────────────────────────────────

# --- Públicas (pueden llegar al navegador) ---
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NUXT_PUBLIC_API_URL=http://127.0.0.1:4000

# --- Privadas (solo servidor: apps/api, scripts, workers) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Proyecto hospedado (provisto por Transformación Digital), en lugar de los valores locales:
#   SUPABASE_URL / NUXT_PUBLIC_SUPABASE_URL = https://<ref>.supabase.co
#   SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY = Project Settings → API Keys
#   DATABASE_URL = cadena del pooler (Connect → Session pooler :5432 o Transaction pooler :6543)
# SSL se activa solo fuera de localhost; en :6543 se desactivan sentencias preparadas. Forzar con:
# DATABASE_SSL=true
# DATABASE_PREPARE=false

# Proveedor de IA: openai | ollama | local (reglas deterministas, sin red)
# Con OPENAI_API_KEY usar AI_PROVIDER=openai; verificar con: npm run ai:check
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
